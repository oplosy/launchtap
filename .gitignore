# Retired design-review captures; Playwright now writes them to web/test-results/screenshots/.
.impeccable/

# Local, unreviewed audit drafts; findings are tracked in backlog.md and docs/specs.
AUDIT_REPORT*.md

# Internal working notes: kept on the maintainer's machine, not published.
# The external audit package and the documents it cites stay published for the auditor.
/docs/specs/*
!/docs/specs/2026-09-01-contract-core-design.md
!/docs/specs/2026-09-11-security-threat-model.md
!/docs/specs/2026-11-11-v2-engine-design.md
