CHAIN_ID=31337
DEPLOYMENT_ID=anvil-local
RPC_URL=http://127.0.0.1:8545
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/launchpad?sslmode=disable

LOG_LEVEL=info
API_ADDR=:8080
API_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated proxy CIDRs whose X-Forwarded-For is trusted; empty = TCP peer is the client.
API_TRUSTED_PROXY_CIDRS=
API_RATE_LIMIT_PER_MINUTE=600
API_RATE_LIMIT_BURST=120
API_SSE_MAX_PER_CLIENT=4
# Optional PostgreSQL pool size per process (4-500); empty keeps the default of 8.
DATABASE_MAX_CONNS=
INDEXER_HEALTH_ADDR=:8081
INDEXER_CHUNK_SIZE=100
# Temporary deep-reorg recovery only: expanded search requires both settings.
INDEXER_REORG_SEARCH_DEPTH=128
INDEXER_REORG_RECOVERY_MODE=false
INDEXER_LOG_ADDRESS_BATCH_SIZE=500
INDEXER_POLL_INTERVAL=1s
RPC_TIMEOUT=10s
RPC_MAX_RETRIES=3
RPC_RETRY_BACKOFF=250ms
INDEXER_WORKER_ID=indexer-1
# Local-development fallback only; production finality comes from the reviewed manifest.
INDEXER_CONFIRMATIONS=

PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
ETH_USD_SOURCE=
