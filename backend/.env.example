CHAIN_ID=31337
DEPLOYMENT_ID=anvil-local
RPC_URL=http://127.0.0.1:8545
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/launchpad?sslmode=disable

LOG_LEVEL=info
API_ADDR=:8080
# Private Prometheus listener for the API; empty disables it. Must differ from API_ADDR and must not be publicly routed.
API_METRICS_ADDR=
API_ALLOWED_ORIGINS=http://localhost:3417
# Comma-separated proxy CIDRs whose X-Forwarded-For is trusted; empty = TCP peer is the client.
API_TRUSTED_PROXY_CIDRS=
API_RATE_LIMIT_PER_MINUTE=600
API_RATE_LIMIT_BURST=120
API_SSE_MAX_PER_CLIENT=4
# Optional PostgreSQL pool size per process (4-500); empty keeps the default of 8.
DATABASE_MAX_CONNS=
INDEXER_HEALTH_ADDR=:8081
INDEXER_CHUNK_SIZE=100
# Temporary deep-reorg recovery only: expanded search requires both settings.
INDEXER_REORG_SEARCH_DEPTH=128
INDEXER_REORG_RECOVERY_MODE=false
INDEXER_LOG_ADDRESS_BATCH_SIZE=500
INDEXER_POLL_INTERVAL=1s
# Automatic pool swap sender backfill (blocks at or below the safe head): pass interval, 0 disables
# (otherwise 1s-24h); and the transactions one pass looks up (1-10000).
INDEXER_SENDER_BACKFILL_INTERVAL=60s
INDEXER_SENDER_BACKFILL_MAX_TXS=500
RPC_TIMEOUT=10s
RPC_MAX_RETRIES=3
RPC_RETRY_BACKOFF=250ms
INDEXER_WORKER_ID=indexer-1
# Local-development fallback only; production finality comes from the reviewed manifest.
INDEXER_CONFIRMATIONS=

PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# Empty disables USD reference pricing; "coingecko" enables it and requires COINGECKO_API_KEY.
ETH_USD_SOURCE=
# Secret: never commit a populated value. Must be empty unless ETH_USD_SOURCE=coingecko.
COINGECKO_API_KEY=
# Telegram alerts (docs/specs/2026-11-12-telegram-alerts-design.md). The API reads only the bot
# username (empty turns the routes off); cmd/telegram needs all three. The token is a secret.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEB_ORIGIN=
# Early-buyer funding sources (docs/specs/2026-11-12-funding-source-clusters-design.md). Only
# cmd/funding reads it: an archive RPC that serves old-block state and debug_traceBlockByNumber
# with the callTracer. Provider URLs carry API keys, so it is a secret.
FUNDING_RPC_URL=
