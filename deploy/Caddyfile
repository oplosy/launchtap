{
	email {$ACME_EMAIL}
	admin off
}

{$WEB_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

{$API_DOMAIN} {
	# Event streams must not be buffered by a compressor.
	@compressible {
		not path /v1/events
	}
	encode @compressible zstd gzip
	# Re-resolves the api service name so `docker compose up --scale api=N` spreads requests over
	# every replica (docs/runbooks/scale-out-and-cdn.md); a single replica works the same way.
	reverse_proxy {
		dynamic a api 8080 {
			refresh 10s
		}
		lb_policy least_conn
	}
}
