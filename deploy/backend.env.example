# Copy outside the checkout with mode 0600; never commit the populated file.
# Percent-encode reserved characters in the password. It must match the password file.
DATABASE_URL=postgres://launchpad:REPLACE_WITH_ENCODED_PASSWORD@postgres:5432/launchpad?sslmode=disable
# Backend RPC may be credentialed; the public web RPC must not contain credentials.
RPC_URL=
PRIVY_APP_ID=
# Compose env_file accepts a single-quoted multiline PEM with real newlines.
PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----
REPLACE_WITH_PRODUCTION_PUBLIC_KEY
-----END PUBLIC KEY-----'
LOG_LEVEL=info
# Private Prometheus listener for the API (e.g. :8082); empty disables it. Never publish this port.
API_METRICS_ADDR=
API_RATE_LIMIT_PER_MINUTE=600
API_RATE_LIMIT_BURST=120
API_SSE_MAX_PER_CLIENT=4
DATABASE_MAX_CONNS=16
INDEXER_CHUNK_SIZE=100
INDEXER_REORG_SEARCH_DEPTH=128
INDEXER_REORG_RECOVERY_MODE=false
INDEXER_LOG_ADDRESS_BATCH_SIZE=500
INDEXER_POLL_INTERVAL=1s
# Automatic pool swap sender backfill (blocks at or below the safe head): pass interval, 0 disables
# (otherwise 1s-24h); and the transactions one pass looks up (1-10000).
INDEXER_SENDER_BACKFILL_INTERVAL=60s
INDEXER_SENDER_BACKFILL_MAX_TXS=500
RPC_TIMEOUT=10s
RPC_MAX_RETRIES=3
RPC_RETRY_BACKOFF=250ms
# Empty disables USD reference pricing; "coingecko" enables it and requires COINGECKO_API_KEY.
ETH_USD_SOURCE=
# Secret: lives only in the external BACKEND_ENV_FILE. Must be empty unless ETH_USD_SOURCE=coingecko.
COINGECKO_API_KEY=
# Telegram alerts (docs/specs/2026-11-12-telegram-alerts-design.md). The API reads only the bot
# username (empty turns the routes off); cmd/telegram needs all three. The token is a secret.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEB_ORIGIN=
