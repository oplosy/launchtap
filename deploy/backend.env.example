# Copy outside the checkout with mode 0600; never commit the populated file.
# No DATABASE_URL here: compose.yaml gives each service a password-less URL for its own role and
# mounts only that role's password secret (DATABASE_PASSWORD_FILE). Set the secret file paths
# (POSTGRES_PASSWORD_FILE, POSTGRES_API_PASSWORD_FILE, POSTGRES_INDEXER_PASSWORD_FILE,
# POSTGRES_TELEGRAM_PASSWORD_FILE) in the Compose environment, each outside the checkout.
# Backend RPC may be credentialed; the public web RPC must not contain credentials.
RPC_URL=
PRIVY_APP_ID=
# Compose env_file accepts a single-quoted multiline PEM with real newlines.
PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----
REPLACE_WITH_PRODUCTION_PUBLIC_KEY
-----END PUBLIC KEY-----'
LOG_LEVEL=info
# Private Prometheus listener for the API (e.g. :8082); empty disables it. Never publish this port.
API_METRICS_ADDR=
API_RATE_LIMIT_PER_MINUTE=600
API_RATE_LIMIT_BURST=120
API_SSE_MAX_PER_CLIENT=4
DATABASE_MAX_CONNS=16
INDEXER_CHUNK_SIZE=100
INDEXER_REORG_SEARCH_DEPTH=128
INDEXER_REORG_RECOVERY_MODE=false
INDEXER_LOG_ADDRESS_BATCH_SIZE=500
# eth_getLogs calls discovery keeps in flight (1-16); 1 fetches sequentially.
INDEXER_LOG_FETCH_CONCURRENCY=4
INDEXER_POLL_INTERVAL=1s
# Automatic pool swap sender backfill (blocks at or below the safe head): pass interval, 0 disables
# (otherwise 1s-24h); and the transactions one pass looks up (1-10000).
INDEXER_SENDER_BACKFILL_INTERVAL=60s
INDEXER_SENDER_BACKFILL_MAX_TXS=500
RPC_TIMEOUT=10s
RPC_MAX_RETRIES=3
RPC_RETRY_BACKOFF=250ms
# Optional second RPC provider for the indexer (secret; empty disables failover). It must pass
# the same chain-id, bytecode and finality checks; switch after N consecutive provider failures
# (1-100) and probe the primary every interval (1s-1h).
RPC_FALLBACK_URL=
RPC_FALLBACK_AFTER_FAILURES=3
RPC_FALLBACK_PROBE_INTERVAL=30s
# Empty disables USD reference pricing; "coingecko" enables it and requires COINGECKO_API_KEY.
ETH_USD_SOURCE=
# Secret: lives only in the external BACKEND_ENV_FILE. Must be empty unless ETH_USD_SOURCE=coingecko.
COINGECKO_API_KEY=
# "pro" (default) or "demo". The free Demo key polls every 5 minutes to stay under its monthly cap.
# Must be empty unless ETH_USD_SOURCE=coingecko.
COINGECKO_API_PLAN=
# Telegram alerts (docs/specs/2026-11-12-telegram-alerts-design.md). The API reads only the bot
# username (empty turns the routes off); cmd/telegram needs all three. The token is a secret.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEB_ORIGIN=
# Early-buyer funding sources (docs/specs/2026-11-12-funding-source-clusters-design.md). Only
# cmd/funding reads it: an archive RPC that serves old-block state and debug_traceBlockByNumber
# with the callTracer. Provider URLs carry API keys, so it is a secret.
FUNDING_RPC_URL=
