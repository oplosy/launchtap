# Copy outside the checkout with mode 0600; never commit the populated file.
# Percent-encode reserved characters in the password. It must match the password file.
DATABASE_URL=postgres://launchpad:REPLACE_WITH_ENCODED_PASSWORD@postgres:5432/launchpad?sslmode=disable
# Backend RPC may be credentialed; the public web RPC must not contain credentials.
RPC_URL=
PRIVY_APP_ID=
# Compose env_file accepts a single-quoted multiline PEM with real newlines.
PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----
REPLACE_WITH_PRODUCTION_PUBLIC_KEY
-----END PUBLIC KEY-----'
LOG_LEVEL=info
API_RATE_LIMIT_PER_MINUTE=600
API_RATE_LIMIT_BURST=120
API_SSE_MAX_PER_CLIENT=4
DATABASE_MAX_CONNS=16
INDEXER_CHUNK_SIZE=100
INDEXER_REORG_SEARCH_DEPTH=128
INDEXER_REORG_RECOVERY_MODE=false
INDEXER_LOG_ADDRESS_BATCH_SIZE=500
INDEXER_POLL_INTERVAL=1s
RPC_TIMEOUT=10s
RPC_MAX_RETRIES=3
RPC_RETRY_BACKOFF=250ms
ETH_USD_SOURCE=
