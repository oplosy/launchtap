# Public deployment inputs only. Replace every value before promotion.
RELEASE_TAG=
WEB_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_DEPLOYMENT_ID=
# Optional: comma-separated engine deployments served side by side (must include the one above).
NEXT_PUBLIC_ENGINE_DEPLOYMENT_IDS=
# Optional: "1" shows the stock token conversion panel (Robinhood Chain mainnet only). Keep it
# off until the legal opinion clears offering stock tokens (docs/specs stock routing pre-flight).
NEXT_PUBLIC_STOCK_ROUTING=
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=
# Absolute paths outside the checkout, readable only by the deployment operator.
BACKEND_ENV_FILE=
POSTGRES_PASSWORD_FILE=
# One password per service login role (postgres/10-service-roles.sh); each file outside the
# checkout, mode 0600, holding only the password.
POSTGRES_API_PASSWORD_FILE=
POSTGRES_INDEXER_PASSWORD_FILE=
POSTGRES_TELEGRAM_PASSWORD_FILE=
