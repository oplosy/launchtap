# Public values only. The application fails closed when any required value is absent.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_DEPLOYMENT_ID=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_RPC_URL=
# Exact deployed origin (e.g. https://launch.example). Used for canonical URLs and the token
# page share buttons; without it the share link is hidden and metadata has no canonical URL.
NEXT_PUBLIC_WEB_ORIGIN=

# Server-only: where the web container reaches our own API (share cards, metadata).
# Falls back to NEXT_PUBLIC_API_BASE_URL. Must be http(s). In Compose: http://api:8080
API_INTERNAL_BASE_URL=
