{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchtap.local/schemas/deployment-v1.json",
  "title": "LaunchTap reviewed deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deploymentId",
    "name",
    "environment",
    "chainId",
    "factory",
    "startBlock",
    "engineVersion",
    "curveImplementation",
    "uniswapV2Factory",
    "uniswapV2Router02",
    "weth",
    "pairInitCodeHash",
    "lpBurnAddress",
    "explorerBase",
    "graduationEnabled",
    "deployTransaction",
    "bytecodeHashes",
    "compiler",
    "toolchain",
    "governance",
    "verification"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deploymentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "environment": { "enum": ["local", "testnet", "production"] },
    "chainId": { "type": "integer", "minimum": 1 },
    "factory": { "$ref": "#/$defs/address" },
    "startBlock": { "type": "integer", "minimum": 0 },
    "engineVersion": { "const": 1 },
    "curveImplementation": { "$ref": "#/$defs/address" },
    "uniswapV2Factory": { "$ref": "#/$defs/address" },
    "uniswapV2Router02": {
      "oneOf": [
        { "$ref": "#/$defs/address" },
        { "type": "null" }
      ]
    },
    "weth": { "$ref": "#/$defs/address" },
    "pairInitCodeHash": { "$ref": "#/$defs/hash" },
    "lpBurnAddress": { "const": "0x000000000000000000000000000000000000dEaD" },
    "explorerBase": { "type": "string" },
    "marketLinks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dexscreenerChain": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "geckoterminalNetwork": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" }
      }
    },
    "graduationEnabled": { "const": true },
    "deployTransaction": { "$ref": "#/$defs/hash" },
    "bytecodeHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launchFactory", "bondingCurveV1", "uniswapV2Factory", "weth"],
      "properties": {
        "launchFactory": { "$ref": "#/$defs/hash" },
        "bondingCurveV1": { "$ref": "#/$defs/hash" },
        "uniswapV2Factory": { "$ref": "#/$defs/hash" },
        "weth": { "$ref": "#/$defs/hash" }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solcVersion", "optimizer", "optimizerRuns", "viaIr", "evmVersion"],
      "properties": {
        "solcVersion": { "const": "0.8.36" },
        "optimizer": { "const": true },
        "optimizerRuns": { "const": 200 },
        "viaIr": { "const": false },
        "evmVersion": { "const": "cancun" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundryVersion"],
      "properties": { "foundryVersion": { "const": "1.8.1" } }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pauseAuthority", "timelock", "protocolTreasury", "deployer"],
      "properties": {
        "pauseAuthority": { "$ref": "#/$defs/address" },
        "timelock": { "$ref": "#/$defs/address" },
        "protocolTreasury": { "$ref": "#/$defs/address" },
        "deployer": { "$ref": "#/$defs/address" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependenciesReviewed",
        "pairInitCodeHashVerified",
        "noResidualDeployerAuthority"
      ],
      "properties": {
        "dependenciesReviewed": { "const": true },
        "pairInitCodeHashVerified": { "const": true },
        "noResidualDeployerAuthority": { "const": true }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
